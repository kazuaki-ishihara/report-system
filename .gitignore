# 実データ・鍵・ログ・バックアップはリポジトリに入れない（基本設計書 §11.1.2）
/app/data/
/app/keys/
/app/logs/
/app/backups/
/app/config/config.local.php
*.sqlite
*.sqlite-*
*.sqlite.backup
*.key

# 検証の出力
/tools/test/output/
/tools/test/output_*.json

# ほかの端末から受け取った検証の記録（DB・鍵を含む。リポジトリに入れない）
/他端末検証/

# チャットの記録の書き出し（tools/test/export_faq_chat_log.php の出力）
/faq_chat_log_*.csv
/app_log_errors_*.txt

# 反映用の一式（tools/deploy/build_package.py などの出力）。差分の一式（diff_*）だけは、手順書と組で管理者に渡すのでリポジトリに入れる
/tools/deploy/output/*
!/tools/deploy/output/diff_*/
__pycache__/
