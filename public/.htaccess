# 公開ディレクトリの設定（さくらのレンタルサーバー / Apache 2.4）
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS へ転送（さくらは SSL をプロキシで終端するため X-Sakura-Forwarded-For で判定する）
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Sakura-Forwarded-For} ^$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# 入り口の補助ファイルは直接開かせない
<Files "_boot.php">
    Require all denied
</Files>

# 画面の入り口でないフォルダーは、置かれていても無いものとして扱う（404）。
#   app/ : 本番では入り口と同じ場所に置く（app/.htaccess でも拒否する。.htaccess の上げ忘れに備えて二重にする）
#   docs/ tools/ public/ : リポジトリを丸ごと上げてしまったときの備え
#   __pycache__ / .git などの隠しフォルダー : 開発の作業フォルダーを写してしまったときの備え
#   data/ keys/ backups/ logs/ config/ lib/ など : 旧システムや手作業で置かれた DB・設定の備え（画面の入り口には無い名前）
RedirectMatch 404 /(app|docs|tools|public|__pycache__|node_modules|vendor)(/|$)
RedirectMatch 404 /(data|keys|backups?|logs?|config|lib|includes?|src|db|database|storage|tmp|private)(/|$)
RedirectMatch 404 /\.(?!well-known/)

# 念のため、DB・鍵・バックアップ・ソースなどの拡張子を拒否する
<FilesMatch "\.(sqlite|sqlite3|db|key|bak|backup|log|md|sql|json|ini|sh|py|pyc|pyo|txt|csv|tsv|zip|tar|gz|tgz|7z|yml|yaml|xml|dist|example|orig|swp|lock|env)$">
    Require all denied
</FilesMatch>
