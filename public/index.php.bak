<?php

require_once '../config/database.php';
require_once '../lib/functions.php';

// レポートを取得
$stmt = $pdo->query("
    SELECT *
    FROM reports
    ORDER BY report_date DESC, id DESC
");

$reports = $stmt->fetchAll();

?>

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>レポート管理</title>

<link rel="stylesheet" href="css/style.css">

</head>

<body>

<div class="container">

    <h1>レポート管理</h1>

    <div class="toolbar">

        <a href="create.php" class="button">
            新規レポート登録
        </a>

    </div>

    <?php if (count($reports) === 0): ?>

        <div class="empty">
            レポートはまだ登録されていません。
        </div>

    <?php else: ?>

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>日付</th>
                    <th>氏名</th>
                    <th>件名</th>
                    <th>操作</th>
                </tr>

            </thead>

            <tbody>

            <?php foreach ($reports as $report): ?>

                <tr>

                    <td>
                        <?= h($report['id']) ?>
                    </td>

                    <td>
                        <?= h($report['report_date']) ?>
                    </td>

                    <td>
                        <?= h($report['name']) ?>
                    </td>

                    <td>
                        <?= h($report['subject']) ?>
                    </td>

<td>

    <a href="edit.php?id=<?= h($report['id']) ?>">
        編集
    </a>

    <form
        action="delete.php"
        method="post"
        style="display:inline;"
        onsubmit="return confirm('このレポートを削除しますか？');"
    >

        <input
            type="hidden"
            name="id"
            value="<?= h($report['id']) ?>"
        >

        <button type="submit">
            削除
        </button>

    </form>

</td>

                </tr>

            <?php endforeach; ?>

            </tbody>

        </table>

    <?php endif; ?>

</div>

</body>

</html>

